{
  "name": "aikitr-uniapp-wotui-monorepo",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "aikitr uniapp wotui monorepo template - a quick-start scaffold for uniapp development",
  "license": "MIT",
  "scripts": {
    "dev:app-a": "pnpm --filter app-a dev:h5",
    "build:app-a": "pnpm --filter app-a build:h5",
    "dev:mp": "pnpm --filter app-a dev:mp",
    "build:mp": "pnpm --filter app-a build:mp",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "typescript": "~5.8.0"
  }
}
