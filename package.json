{
  "name": "aikitr-uniapp-wotui-monorepo",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "aikitr uniapp wotui monorepo template - a quick-start scaffold for uniapp development",
  "license": "MIT",
  "scripts": {
    "dev:free": "pnpm --filter free dev:h5",
    "build:free": "pnpm --filter free build:h5",
    "dev:mp": "pnpm --filter free dev:mp",
    "build:mp": "pnpm --filter free build:mp",
    "type-check": "pnpm -r --if-present run type-check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "version:bump": "node scripts/bump-version.js",
    "postupgrade": "node scripts/postupgrade.js",
    "upload:mp": "node scripts/upload-weixin.js"
  },
  "devDependencies": {
    "@dcloudio/types": "catalog:",
    "@uni-helper/eslint-config": "0.5.0",
    "enquirer": "^2.4.1",
    "eslint": "^9.39.5",
    "lint-staged": "^15.5.2",
    "miniprogram-ci": "^1.9.0",
    "picocolors": "^1.1.0",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --fix"
  }
}
