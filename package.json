{
  "name": "aikitr-uniapp-wotui-monorepo",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "aikitr uniapp wotui monorepo template - a quick-start scaffold for uniapp development",
  "license": "MIT",
  "scripts": {
    "dev:free": "pnpm --filter free dev:h5",
    "build:free": "pnpm --filter free build:h5",
    "dev:mp": "pnpm --filter free dev:mp",
    "build:mp": "pnpm --filter free build:mp",
    "type-check": "tsc --noEmit",
