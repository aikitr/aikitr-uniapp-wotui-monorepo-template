VITE_APP_TITLE = 'aikitr-app-a'
VITE_APP_PORT = 9000

VITE_UNI_APPID = '__UNI__YOUR_APP_A_ID'
VITE_WX_APPID = 'YOUR_WECHAT_APPID_A'

# h5部署网站的base
VITE_APP_PUBLIC_BASE=/

# 默认后台请求地址
VITE_SERVER_BASEURL = 'https://api.yourdomain.com'

# h5是否需要配置代理
VITE_APP_PROXY_ENABLE = false
VITE_APP_PROXY_PREFIX = '/fg-api'

# 第二个请求地址
VITE_SERVER_BASEURL_SECONDARY = 'https://api.yourdomain.com'

# 认证模式
VITE_AUTH_MODE = 'single'

# 原生插件资源复制开关
VITE_COPY_NATIVE_RES_ENABLE = true
